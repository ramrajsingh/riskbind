# Riskbind configuration. Copy to .env and adjust as needed.
#
# Nothing here is a secret: Riskbind reaches no third-party APIs and holds
# no credentials. The activity source is a local MCP server with canned
# demo agents (see README, "What is real and what is mocked"). The only
# API key involved in a full run is the model-provider key, and that is
# held by TrueForge, not by this project.

# --- MCP servers -----------------------------------------------------
# Bind address for both servers. 0.0.0.0 lets TrueForge reach them from a
# container; 127.0.0.1 is the tighter choice when everything is local.
RISKBIND_HOST=0.0.0.0

# agent-activity-source (list_agents, get_agent_activity, log_action)
RISKBIND_ACTIVITY_PORT=8000

# policy-ledger (draft_policy_quote, bind_or_flag)
RISKBIND_POLICY_PORT=8001

# --- Underwriting ----------------------------------------------------
# Flat base premium, before the tier multiplier
# (preferred 0.85x / standard 1.0x / substandard 1.6x / decline: none).
RISKBIND_BASE_PREMIUM=1000.0

# Where bind_or_flag appends its decisions. This file IS the irreversible
# side effect -- point it somewhere visible during a demo.
RISKBIND_LEDGER_PATH=policy_ledger.jsonl
